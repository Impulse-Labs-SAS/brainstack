# BrainStack server configuration for DEVELOPMENT. Copy to apps/server/.env.
# Runs on :3000. The web app runs on :3001 and talks to it over CORS.
# Self-hosting with Docker uses the .env.example at the repository root instead.

NODE_ENV=development
PORT=3000

# --- Required -----------------------------------------------------------------
# Any Postgres. The quickest local one:
#   docker run -d --name brainstack-pg -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17-alpine
#   DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
# Never production: testing delete here deletes real notes.
DATABASE_URL=

# --- Identity -----------------------------------------------------------------
# Where this server answers. Verification links are built from it.
PUBLIC_ORIGIN=http://localhost:3000
# The web app, allowed to call the API and where sign-in redirects land.
CORS_ORIGINS=http://localhost:3001

# --- Who can get in -----------------------------------------------------------
# The first account on a fresh database needs no verification. After it,
# sign-up is closed unless one of these opens it (or an email invitation
# names the address). With OPEN_SIGNUP on, new accounts verify their email,
# so email below must be configured for them.
AUTHORIZED_EMAILS=
OPEN_SIGNUP=

# --- Email --------------------------------------------------------------------
# Resend or SMTP, plus the From address. Links are never printed or logged, so
# to try sign-up or password reset with a second account, point SMTP at a local
# catcher, e.g. Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit,
# then SMTP_HOST=localhost SMTP_PORT=1025 and read the mail at :8025).
# Without email, reset a password with: pnpm --filter @brainstack/server cli reset-password <email>
AUTH_EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# --- Google sign-in (optional) ------------------------------------------------
# Without all three, the Google routes are simply not mounted.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=debug
RATE_LIMIT_PER_MINUTE=60

# Days the Crawl view keeps what gather_context gave each user — the prompt's
# first 2,000 characters and which notes it reached, never their contents — so
# crawls made by an assistant can be replayed. At most 50 per user. Empty means
# 30; 0 turns the history off and deletes what was kept.
CRAWL_HISTORY_DAYS=
MCP_STDIO=false
