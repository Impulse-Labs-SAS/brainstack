# BrainStack server configuration for DEVELOPMENT. Copy to apps/server/.env.
# Runs on :3000. The web app runs on :3001 and talks to it over CORS.
# Self-hosting with Docker uses the .env.example at the repository root instead.

NODE_ENV=development
PORT=3000

# --- Required -----------------------------------------------------------------
# Any Postgres. The quickest local one:
#   docker run -d --name brainstack-pg -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17-alpine
#   DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
# Never production: testing delete here deletes real notes.
DATABASE_URL=

# --- Identity -----------------------------------------------------------------
# Where this server answers. Verification links are built from it.
PUBLIC_ORIGIN=http://localhost:3000
# The web app, allowed to call the API and where sign-in redirects land.
CORS_ORIGINS=http://localhost:3001

# Fine for local. Change it anywhere real.
SESSION_SECRET=dev-secret-please-change-at-least-32-bytes

# --- Sharing ------------------------------------------------------------------
# self-host: one user, no sharing, paths as written.
# hosted:    every note has an owner, folder sharing on. Use this to try the
#            shared folders — the feature is off in self-host.
BRAINSTACK_DEPLOYMENT=hosted

# Comma-separated allowlist. Empty means anyone who signs up gets in, which is
# fine locally and is not fine anywhere else.
AUTHORIZED_EMAILS=

# --- Email --------------------------------------------------------------------
# Leave both empty in development: verification and invite links are printed to
# the server console instead of being sent, so no mail is needed to sign up.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- Google sign-in (optional) ------------------------------------------------
# Without all three, the Google routes are simply not mounted.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=debug
RATE_LIMIT_PER_MINUTE=60
MCP_STDIO=false
