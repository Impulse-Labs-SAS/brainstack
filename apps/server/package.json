{
  "name": "@brainstack/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/extend.d.ts",
      "default": "./dist/extend.js"
    },
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/serve.ts",
    "start": "node dist/serve.js",
    "reindex": "tsx src/reindex.ts",
    "cli": "tsx src/cli.ts",
    "guide": "tsx src/mcp/syncGuide.ts"
  },
  "dependencies": {
    "@brainstack/core": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@trpc/server": "^11.28.0",
    "arctic": "^3.7.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "resend": "^6.38.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "tsx": "^4.23.15"
  }
}
