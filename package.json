{
  "name": "brainstack",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "BrainStack — shared second brain for humans and AI assistants",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @brainstack/core build && pnpm -r typecheck && tsc -p netlify/tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @brainstack/core db:generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "check:functions": "pnpm --filter @brainstack/core build && node scripts/check-functions.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "source-map-js@<1.2.2": "^1.2.2",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "esbuild@>=0.28.0 <0.28.1": "^0.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-rj75-hqrm-r3gf"
      ]
    }
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@netlify/zip-it-and-ship-it": "^15.4.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@brainstack/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "zod": "^4.4.3"
  }
}
