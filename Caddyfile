# Caddyfile — the single origin in front of BrainStack.
#
# DOMAIN comes from .env. A hostname gets a TLS certificate from Let's Encrypt
# automatically; ":80" serves plain HTTP, for trying BrainStack out locally.
#
# The browser, the session cookie and every AI client see one site. The server
# answers the API and the OAuth discovery documents; the web app answers the rest.

{$DOMAIN} {
	encode zstd gzip

	@server path /api/* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server*
	handle @server {
		# A note travels in a request body; nothing larger is ever needed, and
		# without a cap one request could buffer gigabytes into the server.
		request_body {
			max_size 10MB
		}
		# MCP streams its responses; buffering them would hold each one back
		# until it finished.
		reverse_proxy server:3000 {
			flush_interval -1
		}
	}

	handle {
		request_body {
			max_size 2MB
		}
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
