# =============================================================================
# BrainStack — environment variables
# Copy to .env and fill in real values. Validated at startup with zod.
# =============================================================================

# --- Core ---
# Directory where BrainStack notes (.md) and Attachments/ live.
NOTES_DIR=./brain

# Path to the sqlite cache database. Regenerable from NOTES_DIR.
DATABASE_URL=./data/brainstack.db

# Server port (HTTP: tRPC + MCP HTTP/SSE).
PORT=3000

# Public origin used for magic-link URLs and TLS (e.g. https://brain.example.com).
PUBLIC_ORIGIN=http://localhost:3000

# Session cookie secret. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32-byte-hex-secret

# --- MCP transport ---
# If true, the process also listens on stdio for local clients (Claude Code).
MCP_STDIO=false

# --- Auth (magic link via Resend) ---
RESEND_API_KEY=
AUTH_EMAIL_FROM=BrainStack <noreply@example.com>

# Comma-separated list of emails allowed to sign in.
AUTHORIZED_EMAILS=

# --- Backups (optional) ---
# If set, the server pushes the NOTES_DIR to this git remote on a cron.
# Example: git@github.com:you/brainstack-backup.git
BACKUP_REPO=
# Cron expression (node-cron syntax). Default: daily at 03:00.
BACKUP_CRON=0 3 * * *

# --- Logging ---
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Rate limiting ---
# Requests per minute per API key.
RATE_LIMIT_PER_MINUTE=60
