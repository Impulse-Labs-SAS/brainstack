# BrainStack — self-host configuration for docker compose.
#
#   cp .env.example .env
#   # fill in the required values below
#   docker compose up -d
#
# For development without Docker, see apps/server/.env.example instead.

# --- Required -----------------------------------------------------------------

# The public hostname BrainStack answers on, e.g. brain.example.com. Caddy gets
# a TLS certificate for it from Let's Encrypt on first start, so the name must
# already resolve to this machine and ports 80 and 443 must be reachable.
# ":80" serves plain HTTP on this machine, for trying BrainStack out.
DOMAIN=:80

# The URL people and AI clients reach BrainStack at: https://<DOMAIN>, or
# http://localhost when DOMAIN is ":80". Links in emails and the OAuth issuer
# for MCP clients are built from it, so it has to be exact.
PUBLIC_ORIGIN=http://localhost

# Password for the bundled Postgres. It goes inside a connection string, so keep
# to letters and digits — `openssl rand -hex 24` makes a good one.
POSTGRES_PASSWORD=

# --- Who can get in -----------------------------------------------------------

# The first account created on a new instance is its owner, and needs no email
# verification. Create yours right after the first start. After that, sign-up
# is closed: nobody else can create an account unless one of these lets them,
# or you invite them to a shared folder by email.

# Comma-separated emails that may create an account. When set, the first
# account must be one of them too.
AUTHORIZED_EMAILS=

# true lets anyone who can reach this server create an account. Leave it empty
# unless that is what you want; new accounts then verify their email.
OPEN_SIGNUP=

# --- Database (optional) ------------------------------------------------------

# Leave empty to use the bundled Postgres (version 17). Set it to use your own
# instead, managed ones included (Neon, Supabase, RDS, ...). The schema needs
# generated columns, so Postgres 12 is the oldest that can work.
DATABASE_URL=

# --- Email (optional for one person, needed to add others) -------------------

# BrainStack emails verification links, password resets and folder
# invitations. Configure Resend or any SMTP server (Gmail, Outlook, your
# company's relay, Resend's own SMTP), plus the From address. Links are never
# written to the log.
#
# Without email, BrainStack works for its first account alone: nobody else can
# sign up with a password, and a forgotten password is reset on the server:
#   docker compose exec server node dist/cli.js reset-password you@example.com

# The From address, e.g. "BrainStack <brain@example.com>". Required for either.
AUTH_EMAIL_FROM=

# Resend (https://resend.com): the API key. Takes precedence over SMTP.
RESEND_API_KEY=

# SMTP. Port 587 uses STARTTLS; 465 uses TLS from the start (SMTP_SECURE
# follows the port unless set). With Gmail, use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# --- Google sign-in (optional) ------------------------------------------------

# Without all three, "Continue with Google" is not offered. The redirect URI is
# <PUBLIC_ORIGIN>/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Misc ---------------------------------------------------------------------

LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60

# Days the Crawl view keeps what gather_context gave each user — the prompt's
# first 2,000 characters and which notes it reached, never their contents — so
# crawls made by an assistant can be replayed. At most 50 per user. Empty means
# 30; 0 turns the history off and deletes what was kept.
CRAWL_HISTORY_DAYS=
