# =============================================================================
# BrainStack — environment variables
# Copy to .env and fill in real values. Validated at startup with zod.
# =============================================================================

# --- Core ---
# Directory where BrainStack notes (.md) and Attachments/ live.
NOTES_DIR=./brain

# Path to the sqlite cache database. Regenerable from NOTES_DIR (auth tables
# in this DB are NOT regenerable — see BACKUP_DIR below).
DATABASE_URL=./data/brainstack.db

# Server port (HTTP: tRPC + MCP HTTP/SSE).
PORT=3000

# Public origin used in auth callbacks and email URLs (e.g. https://brain.example.com).
PUBLIC_ORIGIN=http://localhost:3000

# Public domain Caddy fronts (Let's Encrypt). Leave as :80 for local HTTP.
DOMAIN=:80

# Session cookie secret. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32-byte-hex-secret

# Comma-separated origins allowed by CORS. Add your web app origin.
CORS_ORIGINS=http://localhost:3001

# --- MCP transport ---
# If true, the process also listens on stdio for local clients (Claude Code).
MCP_STDIO=false

# --- Auth: Resend (transactional email for password reset + verification) ---
# Optional in development — when blank, links are printed to the log and
# echoed back in the signup/forgot-password JSON response.
# Required in production: the server refuses to start the auth flow otherwise.
RESEND_API_KEY=
AUTH_EMAIL_FROM=BrainStack <noreply@example.com>

# Comma-separated list of emails allowed to sign in.
# Leave blank in dev to allow anyone (single-user assumption).
AUTHORIZED_EMAILS=

# --- Auth: Google OAuth ---
# All three must be set to enable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match what you register there.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Backups (optional) ---
# Git remote where the backup repo is pushed (private). Leave blank to disable.
# Example: git@github.com:you/brainstack-backup.git
BACKUP_REPO=

# Absolute path to the local git clone used as the backup target. The cron
# writes the sqlite snapshot here, then commits + pushes the working tree
# (which also includes a mirror of NOTES_DIR). Leave blank to disable.
# Example: /var/lib/brainstack/backup
BACKUP_DIR=

# Cron expression (node-cron syntax). Default: daily at 03:00.
BACKUP_CRON=0 3 * * *

# --- Logging ---
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Rate limiting ---
# Requests per minute per API key.
RATE_LIMIT_PER_MINUTE=60
